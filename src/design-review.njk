<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Design Review — Zach Miller Studio</title>
  <meta name="robots" content="noindex">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      background: #1c1c1f;
      font-family: -apple-system, Helvetica, Arial, sans-serif;
      display: flex;
      flex-direction: column;
    }

    .bar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
      padding: 0.6rem 1.25rem;
      background: #242428;
      border-bottom: 1px solid #38383e;
    }
    .bar-group { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
    .bar-label {
      color: #86868c;
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-right: 0.25rem;
      white-space: nowrap;
    }
    .bar-btn {
      background: transparent;
      color: #c8c8cc;
      border: 1px solid #48484f;
      padding: 0.32rem 0.75rem;
      font-size: 0.68rem;
      letter-spacing: 0.03em;
      cursor: pointer;
      border-radius: 3px;
      white-space: nowrap;
      font-family: inherit;
    }
    .bar-btn:hover { background: #38383e; color: #fff; }
    .bar-btn.active { background: #fff; color: #17171a; border-color: #fff; font-weight: 600; }

    .stage {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 0;
      overflow: hidden;
    }
    .stage.framed { padding: 1.5rem; align-items: center; }
    .frame {
      width: 100%;
      height: 100%;
      border: none;
      background: #fff;
      transition: width 0.25s ease;
    }
    .stage.framed .frame {
      max-height: 100%;
      height: 100%;
      border-radius: 14px;
      box-shadow: 0 8px 50px rgba(0,0,0,0.5);
      border: 1px solid #48484f;
    }
  </style>
</head>
<body>

  <div class="bar">
    <div class="bar-group" id="themes">
      <span class="bar-label">Theme</span>
      <button class="bar-btn active" data-theme="current">Current</button>
      <button class="bar-btn" data-theme="gallery-white">A · Gallery White</button>
      <button class="bar-btn" data-theme="atelier-dark">B · Atelier Dark</button>
      <button class="bar-btn" data-theme="editorial">C · Editorial</button>
    </div>
    <div class="bar-group" id="pages">
      <span class="bar-label">Page</span>
      <button class="bar-btn active" data-page="/">Home</button>
      <button class="bar-btn" data-page="/work/">Portfolio</button>
      <button class="bar-btn" data-page="/work/cascade/">Work Detail</button>
      <button class="bar-btn" data-page="/about/">About</button>
      <button class="bar-btn" data-page="/contact/">Contact</button>
    </div>
    <div class="bar-group" id="viewports">
      <span class="bar-label">Viewport</span>
      <button class="bar-btn active" data-vw="">Desktop</button>
      <button class="bar-btn" data-vw="768">Tablet</button>
      <button class="bar-btn" data-vw="390">Mobile</button>
    </div>
  </div>

  <div class="stage" id="stage">
    <iframe class="frame" id="frame" src="/?theme=current" title="Site preview"></iframe>
  </div>

  <script>
    (function () {
      var state = { theme: 'current', page: '/', vw: '' };
      var frame = document.getElementById('frame');
      var stage = document.getElementById('stage');

      function reload() {
        frame.src = state.page + '?theme=' + state.theme;
        if (state.vw) {
          stage.classList.add('framed');
          frame.style.width = state.vw + 'px';
        } else {
          stage.classList.remove('framed');
          frame.style.width = '100%';
        }
      }

      function wire(groupId, key, attr) {
        var group = document.getElementById(groupId);
        group.addEventListener('click', function (e) {
          var btn = e.target.closest('.bar-btn');
          if (!btn) return;
          group.querySelectorAll('.bar-btn').forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          state[key] = btn.getAttribute(attr) || '';
          reload();
        });
      }

      wire('themes', 'theme', 'data-theme');
      wire('pages', 'page', 'data-page');
      wire('viewports', 'vw', 'data-vw');
    })();
  </script>

</body>
</html>
